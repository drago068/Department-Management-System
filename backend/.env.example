# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║          College Management System — Backend Environment Config              ║
# ║  Copy this file to .env and fill in your values.  Never commit .env!        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME="College Management System (CMS) API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"   # development | production
DEBUG=True

# ── Database ──────────────────────────────────────────────────────────────────
# Option 1: Local SQLite (zero-setup, for development only)
DATABASE_URL="sqlite+aiosqlite:///./cms.db"

# Option 2: Supabase PostgreSQL (recommended for production)
# HOW TO GET THIS URL:
#   1. Go to https://supabase.com → your project → Settings → Database
#   2. Under "Connection string" choose "URI" tab
#   3. Select "Transaction" mode (port 6543) — best for async FastAPI
#   4. Copy the URI and replace [YOUR-PASSWORD] below
#
# DATABASE_URL="postgresql+asyncpg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"
#
# Option 3: Direct connection (use port 5432, Session mode — no pgbouncer)
# DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres"

# Connection pool settings (PostgreSQL only — ignored for SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Supabase Project Config ───────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
# SUPABASE_URL="https://[project-ref].supabase.co"
# SUPABASE_ANON_KEY="eyJ..."      # Public anon key (safe to expose to clients)
# SUPABASE_SERVICE_ROLE_KEY="eyJ..." # Secret key (server-side ONLY, never expose)

# ── JWT & Security ────────────────────────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="super-secret-development-key-change-in-production-nexus-cms"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://localhost:3000,http://localhost:8082"

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25
